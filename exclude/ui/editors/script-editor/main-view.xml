<?xml version="1.0" encoding="utf-8"?>
<vbox width="100%" height="100%">
	<import source="components/menu.xml" />

	<hbox width="100%" height="100%">
		<vbox width="230" height="100%" style="padding: 4px; spacing: 4px; background-color: #20242B;">
			<label text="Scripts" width="100%" />
			<textfield id="scriptFilter" width="100%" placeholder="Filter" />
			<listview id="scriptList" width="100%" height="100%" />
			<hbox width="100%">
				<button id="scriptReload" text="Reload" width="50%" />
				<button id="scriptNew" text="New" width="50%" />
			</hbox>
		</vbox>

		<vbox width="100%" height="100%">
			<hbox width="100%" style="padding: 4px; spacing: 6px; background-color: #2B2B2B;">
				<textfield id="pathInput" width="100%" />
				<button id="toolSave" text="Save" width="58" />
				<button id="toolCheck" text="Check" width="62" />
				<button id="toolRun" text="Run" width="52" />
				<button id="toolStop" text="Stop" width="56" />
				<button id="toolUndo" text="Undo" width="58" />
				<button id="toolRedo" text="Redo" width="58" />
			</hbox>

			<box id="editorArea" width="100%" height="62%" />

			<hbox id="findBar" width="100%" hidden="true" style="padding: 4px; spacing: 6px; background-color: #2B2B2B;">
				<textfield id="findInput" width="190" placeholder="Find" />
				<textfield id="replaceInput" width="150" placeholder="Replace" />
				<button id="findPreviousButton" text="Prev" width="52" />
				<button id="findNextButton" text="Next" width="52" />
				<button id="findReplaceButton" text="Replace" width="72" />
				<button id="findReplaceAllButton" text="All" width="42" />
				<checkbox id="findCaseBox" text="Aa" />
				<label id="findInfo" text="" width="100%" verticalAlign="center" />
				<textfield id="gotoInput" width="64" placeholder="Line" />
				<button id="findCloseButton" text="X" width="32" />
			</hbox>

			<box id="consoleArea" width="100%" height="100%" />

			<hbox width="100%" style="padding: 2px 8px; background-color: #1B1E24;">
				<label id="statusLabel" text="" width="100%" />
			</hbox>
		</vbox>

		<import source="components/bot.xml" />
	</hbox>
</vbox>
