<?xml version="1.0" encoding="utf-8"?>
<dialog width="800" height="500" title="Script Editor - Welcome">
	<vbox width="100%" height="100%">
		<label text="Welcome to Script Editor" width="100%" style="font-size: 20px; text-align: center;" />
		<label text="Create and edit your mod scripts" width="100%" style="text-align: center;" />
		<hbox width="100%" height="100%">
			<vbox width="35%" height="100%">
				<card id="welcomeSectionCreate" width="100%" height="60%" text="Create New">
					<link id="welcomeNewLua" width="100%" text="New .lua Script" />
					<label text="Create a Lua script for your mod." width="100%" />
					<link id="welcomeNewHxc" width="100%" text="New .hxc Script" />
					<label text="Create a Haxe script (HScript)." width="100%" />
				</card>
				<card id="welcomeSectionActions" width="100%" height="40%" text="Quick Actions">
					<link id="welcomeOpenFolder" width="100%" text="Open Mods Folder" />
					<link id="welcomeRefresh" width="100%" text="Refresh Scripts" />
				</card>
			</vbox>
			<card id="welcomeSectionScripts" width="65%" height="100%" text="Open Existing Script">
				<textfield id="welcomeFilter" width="100%" placeholder="Search scripts..." />
				<listview id="welcomeScriptList" width="100%" height="85%" />
				<label id="welcomeScriptCount" text="" width="100%" />
			</card>
		</hbox>
	</vbox>
</dialog>
