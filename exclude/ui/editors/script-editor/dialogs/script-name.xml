<?xml version="1.0" encoding="utf-8"?>
<dialog width="420" height="220" title="New Script - Name">
	<vbox width="100%" height="100%" style="padding: 8px; spacing: 8px;">
		<label id="nameHeader" text="Name of the new script" width="100%" />
		<textfield id="nameInput" width="100%" placeholder="my-script" />
		<label id="nameError" text="" width="100%" style="color: #FF6B6B;" />
		<hbox width="100%" style="spacing: 8px;">
			<button id="nameCreate" text="Create" width="50%" />
			<button id="nameCancel" text="Cancel" width="50%" />
		</hbox>
	</vbox>
</dialog>
