<?xml version="1.0" encoding="utf-8"?>
<hbox width="100%" style="padding: 4px; spacing: 6px; background-color: #2B2B2B;">
	<button id="playbarPlay" text="Play" width="72" />
	<button id="playbarRestart" text="Start" width="60" />
	<label id="playbarTime" text="0:00.000 / 0:00" width="150" verticalAlign="center" />
	<label id="playbarStatus" text="" width="100%" verticalAlign="center" />
	<label text="Snap" verticalAlign="center" />
	<dropdown id="playbarSnap" width="92" selectedIndex="2">
		<data>
			<item id="0" text="Off" />
			<item id="1" text="1 beat" />
			<item id="2" text="1/2 beat" />
			<item id="4" text="1/4 beat" />
			<item id="8" text="1/8 beat" />
			<item id="3" text="1/3 beat" />
			<item id="6" text="1/6 beat" />
		</data>
	</dropdown>
	<button id="playbarZoomOut" text="Out" width="48" />
	<button id="playbarZoomIn" text="In" width="44" />
	<button id="playbarFit" text="Fit" width="52" />
	<button id="playbarAdd" text="Add" width="56" />
	<button id="playbarUndo" text="Undo" width="58" />
	<button id="playbarRedo" text="Redo" width="58" />
	<button id="playbarDelete" text="Del" width="50" />
</hbox>
